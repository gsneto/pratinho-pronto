    "qa:build": "node qa/build.mjs",
    "qa:serve": "node --import tsx qa/serve.mjs",
    "qa:audit": "node qa/audit.mjs",
    "qa:flows": "node qa/flows.mjs",
    "qa:dialogs": "node qa/dialogs.mjs",
    "qa:pwa": "node qa/pwa-install.mjs",
    "qa:regressions": "node qa/regressions.mjs",
    "design:lint": "designmd lint DESIGN.md",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.8.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
