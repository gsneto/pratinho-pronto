# Somente variáveis públicas do cliente Supabase.
# Nunca adicione SUPABASE_SERVICE_ROLE_KEY ao frontend.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-ou-publishable
VITE_CHECKOUT_URL=https://seu-checkout.com
# Opcionais: analytics só carregam quando configurados no host.
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# Variáveis somente do servidor (Vercel/API). Nunca expor no frontend.
# Use a URL do projeto Supabase e a chave service_role nas funções serverless.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Deve ser exatamente a chave secreta configurada no webhook da Cakto.
CAKTO_WEBHOOK_SECRET=
